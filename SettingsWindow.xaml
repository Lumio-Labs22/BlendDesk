<local:AnimatedWindow x:Class="BlenderLibrary.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BlenderLibrary"
        Title="BlendDesk Settings" Icon="Assets/BlendDesk.ico" Width="590" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" xml:lang="en-US"
        Background="{DynamicResource Paper}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Grid Background="{DynamicResource Paper}">
        <Border Background="{DynamicResource Glow}" IsHitTestVisible="False"/>
        <Border Background="{DynamicResource CounterGlow}" IsHitTestVisible="False"/>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Settings" Style="{StaticResource Title}" Margin="26,20,26,19"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Margin="19,0">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimVerticalScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel Margin="7,0,7,6">
                <ContentControl Style="{StaticResource AppPanel}" Padding="16" Margin="0,0,0,13">
                    <StackPanel>
                        <TextBlock Text="Appearance" Style="{StaticResource Section}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="11"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="CleanChoice" GroupName="Appearance" Style="{StaticResource AppearanceChoice}"
                                         AutomationProperties.Name="Clean" Click="PreviewAppearance">
                                <StackPanel>
                                    <Border Height="68" Background="#19120E" BorderBrush="#74503C" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Background="#39261B" CornerRadius="5" Margin="0,0,5,0"/>
                                            <Border Grid.Column="1" Background="#2B1D15" CornerRadius="5" Padding="9,7">
                                                <StackPanel>
                                                    <Border Background="#FF9652" CornerRadius="2" Height="4" Width="26" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                                                    <Border Background="#543322" CornerRadius="2" Height="15"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="Clean" FontWeight="SemiBold" Margin="0,7,0,2"/>
                                    <TextBlock Text="Solid surfaces" Style="{StaticResource Secondary}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="GlassChoice" Grid.Column="2" GroupName="Appearance" Style="{StaticResource AppearanceChoice}"
                                         AutomationProperties.Name="Liquid Glass" Click="PreviewAppearance">
                                <StackPanel>
                                    <Border Height="68" BorderBrush="#C2986648" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                <GradientStop Color="#27150D" Offset="0"/>
                                                <GradientStop Color="#50301E" Offset="0.55"/>
                                                <GradientStop Color="#9C5029" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Background="#8E24160F" BorderBrush="#CF9269" BorderThickness="1" CornerRadius="5" Margin="0,0,5,0"/>
                                            <Border Grid.Column="1" BorderBrush="#CF9269" BorderThickness="1" CornerRadius="10" Padding="9,6">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#C4774C34" Offset="0"/>
                                                        <GradientStop Color="#963F2417" Offset="0.56"/>
                                                        <GradientStop Color="#B25E3725" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <StackPanel>
                                                    <Border Background="#FF9A56" CornerRadius="2" Height="4" Width="26" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                                                    <Border Background="#9FC1784D" CornerRadius="5" Height="15"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="Liquid Glass" FontWeight="SemiBold" Margin="0,7,0,2"/>
                                    <TextBlock Text="Layered glass and reflections" Style="{StaticResource Secondary}"/>
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,15,0,0" Padding="0,13,0,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{DynamicResource Field}" BorderBrush="{DynamicResource GlassRim}"
                                        BorderThickness="1" CornerRadius="{DynamicResource ToolbarFieldRadius}" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="LightChoice" Content="Light" GroupName="ColorMode" Click="PreviewAppearance"
                                                     Style="{StaticResource ViewButton}" MinWidth="58" AutomationProperties.Name="Light color mode"/>
                                        <RadioButton x:Name="DarkChoice" Content="Dark" GroupName="ColorMode" Click="PreviewAppearance"
                                                     Style="{StaticResource ViewButton}" MinWidth="58" AutomationProperties.Name="Dark color mode"/>
                                        <RadioButton x:Name="SystemChoice" Content="System" GroupName="ColorMode" Click="PreviewAppearance"
                                                     Style="{StaticResource ViewButton}" MinWidth="58" AutomationProperties.Name="System color mode"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Color mode" FontWeight="SemiBold"/>
                                    <TextBlock Text="System follows Windows." Style="{StaticResource Secondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource AppPanel}" Padding="16" Margin="0,0,0,13">
                    <StackPanel>
                        <TextBlock Text="Background" Style="{StaticResource Section}" Margin="0,0,0,10"/>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                <Button x:Name="ChooseImageButton" Content="Choose image…" Click="ChooseImage"/>
                                <Button x:Name="DefaultBackgroundButton" Content="Use default" Click="UseDefaultBackground"
                                        Margin="7,0,0,0"/>
                            </StackPanel>
                            <Grid Width="55" Height="38" Margin="0,0,10,0" DockPanel.Dock="Left">
                                <Border Background="{DynamicResource Cover}" CornerRadius="8">
                                    <TextBlock x:Name="DefaultThumbnail" Text="&#xEB9F;" Style="{StaticResource Icon}"
                                               Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                                </Border>
                                <Border CornerRadius="8">
                                    <Border.Background>
                                        <ImageBrush x:Name="BackgroundThumbnail" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="BackgroundName" Style="{StaticResource Trimmed}" VerticalAlignment="Center"
                                       Margin="0,0,9,0" AutomationProperties.LiveSetting="Polite"/>
                        </DockPanel>
                    </StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource AppPanel}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Blender" Style="{StaticResource Section}"/>
                        <TextBlock Text="Used to open projects and generate previews." Style="{StaticResource Secondary}" Margin="0,3,0,10"/>
                        <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="9" Padding="9">
                            <StackPanel>
                                <TextBlock x:Name="LocationMode" FontWeight="SemiBold"/>
                                <TextBlock x:Name="Location" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <Button Content="Browse…" Click="BrowseBlender"/>
                            <Button x:Name="AutomaticButton" Content="Use automatic" Click="UseAutomatic" Margin="7,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ContentControl>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Margin="26,13,26,22">
                <Button Content="Cancel" IsCancel="True" MinWidth="76"/>
                <Button x:Name="DoneButton" Content="Done" Click="Done" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" MinWidth="76" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</local:AnimatedWindow>
